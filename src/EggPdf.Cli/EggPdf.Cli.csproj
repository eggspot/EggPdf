<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EggPdf.Cli</RootNamespace>
    <AssemblyName>EggPdf.Cli</AssemblyName>
    <Description>Command-line tool for HTML to PDF conversion</Description>
    <Version>1.3.0</Version>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eggpdf</ToolCommandName>
    <PackageId>dotnet-eggpdf</PackageId>
    <Authors>Eggspot</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eggspot/EggPdf</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggPdf\EggPdf.csproj" />
  </ItemGroup>

</Project>
