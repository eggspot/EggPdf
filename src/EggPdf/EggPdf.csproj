<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EggPdf</RootNamespace>
    <Version>1.0.0</Version>
    <IsPackable>true</IsPackable>

    <!-- NuGet package metadata -->
    <PackageId>EggPdf</PackageId>
    <Authors>Eggspot</Authors>
    <Company>Eggspot</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eggspot/EggPdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eggspot/EggPdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;html-to-pdf;html;css;rendering-engine;pdf-generation;zero-dependency;csharp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggPdf.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggPdf.Core\EggPdf.Core.csproj" />
    <ProjectReference Include="..\EggPdf.Html\EggPdf.Html.csproj" />
    <ProjectReference Include="..\EggPdf.Css\EggPdf.Css.csproj" />
    <ProjectReference Include="..\EggPdf.Style\EggPdf.Style.csproj" />
    <ProjectReference Include="..\EggPdf.Layout\EggPdf.Layout.csproj" />
    <ProjectReference Include="..\EggPdf.Text\EggPdf.Text.csproj" />
    <ProjectReference Include="..\EggPdf.Svg\EggPdf.Svg.csproj" />
    <ProjectReference Include="..\EggPdf.Fragmentation\EggPdf.Fragmentation.csproj" />
    <ProjectReference Include="..\EggPdf.Paint\EggPdf.Paint.csproj" />
    <ProjectReference Include="..\EggPdf.Pdf\EggPdf.Pdf.csproj" />
  </ItemGroup>

</Project>


